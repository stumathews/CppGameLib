{
  "version": 2,
  "configurePresets": [   
    {
      "name": "windows",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/builddir",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux",
      "generator" : "Ninja",
      "binaryDir": "${sourceDir}/builddir",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
